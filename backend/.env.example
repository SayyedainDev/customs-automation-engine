# Replace the username and password with the PostgreSQL role you create locally.
CUSTOMS_DATABASE_URL=postgresql+psycopg://customs_user:your_password@localhost:5432/customs_engine

# Optional overrides
CUSTOMS_UPLOAD_DIR=uploads/documents
CUSTOMS_MAX_UPLOAD_SIZE_MB=10

# Optional. Without a key, deterministic extraction/checks and template
# explanations still work. Hybrid mode caches unchanged documents and makes at
# most one Groq extraction call per document when local extraction has gaps.
GROQ_API_KEY=
CUSTOMS_GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MAX_COMPLETION_TOKENS=2000
GROQ_SUPPORTING_GAPFILL_MAX_COMPLETION_TOKENS=512
SUPPORTING_GAPFILL_SNIPPETS_PER_FIELD=2
SUPPORTING_GAPFILL_SNIPPET_CHARACTERS=500
SUPPORTING_GAPFILL_MAX_CONTEXT_CHARACTERS=2500
SUPPORTING_GAPFILL_MAX_PAGES=3
EXTRACTION_MODE=hybrid

# Phase 2B page-level OCR. Install the Tesseract executable and English data.
CUSTOMS_OCR_EXECUTABLE=tesseract
CUSTOMS_OCR_LANGUAGE=eng
CUSTOMS_OCR_DPI=300
CUSTOMS_OCR_PAGE_SEGMENTATION_MODE=4
CUSTOMS_OCR_TIMEOUT_SECONDS=60
CUSTOMS_OCR_MIN_CONFIDENCE=0.80

# Regulatory RAG: dense embeddings, cross-encoder reranker, and SQL vector store.
# Real models are used only if `sentence-transformers` is installed and the model
# can load; otherwise the system runs in explicitly labelled degraded mode
# (hashing embeddings + lexical reranker, degraded_mode=true). Set
# REGULATORY_ENABLE_REAL_MODELS=false to force degraded mode (e.g. CI).
REGULATORY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REGULATORY_EMBEDDING_BATCH_SIZE=32
REGULATORY_EMBEDDING_DEVICE=cpu
REGULATORY_VECTOR_COLLECTION=regulatory_child_chunks
REGULATORY_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
REGULATORY_RERANK_TOP_N=25
REGULATORY_RERANK_DEVICE=cpu
REGULATORY_ENABLE_REAL_MODELS=true

# Phase 3C: LangGraph multi-agent customs-audit orchestration.
# Checkpoint backend: postgres (deployed app, reuses CUSTOMS_DATABASE_URL) |
# sqlite (durable local demo file) | memory (tests only).
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_PATH=customs_audit_checkpoints.sqlite3
LANGGRAPH_WORKFLOW_TIMEOUT_SECONDS=300
LANGGRAPH_MAX_RETRIES=2
# When false, Broker/Auditor use deterministic (non-LLM) report builders.
LANGGRAPH_ENABLE_LIVE_AGENTS=false
LANGGRAPH_BROKER_MODEL=
LANGGRAPH_AUDITOR_MODEL=
LANGGRAPH_EXPLANATION_MODEL=
LANGGRAPH_HUMAN_REVIEW_REQUIRED=true
LANGGRAPH_OCR_REVIEW_THRESHOLD=0.80
